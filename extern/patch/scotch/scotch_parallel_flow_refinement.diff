+/************************************************************/
+/**                                                        **/
+/**   NAME       : bdgraph_bipart_fl.c                     **/
+/**                                                        **/
+/**   AUTHOR     : Hugh CARSON                             **/
+/**                                                        **/
+/**   FUNCTION   : This module refines a distributed       **/
+/**                bipartition by computing, on each       **/
+/**                process at the same time, a minimum     **/
+/**                cut by maximum flow within the local    **/
+/**                part of the graph, ghost vertices being **/
+/**                kept in their parts. Each process may   **/
+/**                use its share of the load slack of the  **/
+/**                two parts. The global cut is computed   **/
+/**                afterwards, and the refinement is       **/
+/**                undone if it did not decrease it.       **/
+/**                It only acts on band graphs, the two    **/
+/**                last local vertices of each process of  **/
+/**                which are anchors; they and their       **/
+/**                neighbors never move, so that anchors   **/
+/**                never reach the frontier. On any other  **/
+/**                graph, it does nothing.                 **/
+/**                                                        **/
+/**   DATES      : # Version 7.0  : from : 14 nov 2026     **/
+/**                                 to   : 17 nov 2026     **/
+/**                                                        **/
+/************************************************************/
+
+/*
+**  The defines and includes.
+*/
+
+#include "module.h"
+#include "common.h"
+#include "graph.h"
+#include "arch.h"
+#include "bgraph.h"
+#include "bgraph_bipart_fl.h"
+#include "dgraph.h"
+#include "bdgraph.h"
+#include "bdgraph_bipart_fl.h"
+
+/*****************************/
+/*                           */
+/* These are the subroutines.*/
+/*                           */
+/*****************************/
+
+/* This routine refines the local part of the
+** distributed bipartition, ghost vertices being
+** fixed in their current parts.
+** It returns:
+** - 0   : if the refinement could be computed.
+** - !0  : on error.
+*/
+
+static
+int
+bdgraphBipartFl2 (
+Bdgraph * const                     grafptr,      /*+ Distributed graph +*/
+const BdgraphBipartFlParam * const  paraptr)      /*+ Method parameters +*/
+{
+  Graph                   cgrfdat;                /* Local subgraph               */
+  Bgraph                  bgrfdat;                /* Local bipartition graph      */
+  BgraphBipartFlParam     fparadat;               /* Parameters of sequential method */
+  Gnum * restrict         verttax;
+  Gnum * restrict         edgetax;
+  Gnum * restrict         edlotax;
+  Gnum * restrict         veextax;
+  byte * restrict         fixdtax;                /* Flags of vertices that must not move */
+  Gnum                    vertnum;
+  Gnum                    edgenum;
+  Gnum                    edlosum;
+  Gnum                    degrmax;
+  Gnum                    commloadextn0;
+  Gnum                    commgainextn0;
+  Gnum                    slcktab[2];
+  int                     o;
+
+  const Gnum                        baseval    = grafptr->s.baseval;
+  const Gnum                        vertlocnnd = grafptr->s.vertlocnnd;
+  const Gnum * restrict const       vertloctax = grafptr->s.vertloctax;
+  const Gnum * restrict const       vendloctax = grafptr->s.vendloctax;
+  const Gnum * restrict const       edgegsttax = grafptr->s.edgegsttax;
+  const Gnum * restrict const       edloloctax = grafptr->s.edloloctax;
+  const Gnum * restrict const       veexloctax = grafptr->veexloctax;
+  GraphPart * restrict const        partgsttax = grafptr->partgsttax;
+
+  slcktab[0] = MAX (grafptr->compglbload0 - grafptr->compglbload0min, 0) / grafptr->s.procglbnbr; /* Share of load slack of each part */
+  slcktab[1] = MAX (grafptr->compglbload0max - grafptr->compglbload0, 0) / grafptr->s.procglbnbr;
+  if (((slcktab[0] | slcktab[1]) == 0) || (grafptr->fronlocnbr == 0))
+    return (0);
+
+  if (memAllocGroup ((void **) (void *)
+                     &verttax,         (size_t) ((grafptr->s.vertlocnbr + 1) * sizeof (Gnum)),
+                     &veextax,         (size_t) (grafptr->s.vertlocnbr * sizeof (Gnum)),
+                     &bgrfdat.parttax, (size_t) (grafptr->s.vertlocnbr * sizeof (GraphPart)),
+                     &bgrfdat.frontab, (size_t) (grafptr->s.vertlocnbr * sizeof (Gnum)),
+                     &fixdtax,         (size_t) (grafptr->s.vertlocnbr * sizeof (byte)), NULL) == NULL) {
+    errorPrint ("bdgraphBipartFl2: out of memory (1)");
+    return (1);
+  }
+  if ((edgetax = memAlloc (grafptr->s.edgelocnbr * ((edloloctax != NULL) ? 2 : 1) * sizeof (Gnum) + 1)) == NULL) {
+    errorPrint ("bdgraphBipartFl2: out of memory (2)");
+    memFree (verttax);
+    return (1);
+  }
+  verttax -= baseval;
+  veextax -= baseval;
+  edgetax -= baseval;
+  edlotax  = (edloloctax != NULL) ? (edgetax + grafptr->s.edgelocnbr) : NULL;
+  bgrfdat.parttax -= baseval;
+  fixdtax -= baseval;
+  memSet (fixdtax + baseval, 0, grafptr->s.vertlocnbr * sizeof (byte));
+  for (vertnum = MAX (vertlocnnd - 2, baseval); vertnum < vertlocnnd; vertnum ++) { /* Anchors and their neighbors never move, so that anchors stay away from frontier */
+    Gnum                edgelocnum;
+
+    fixdtax[vertnum] = 1;
+    for (edgelocnum = vertloctax[vertnum]; edgelocnum < vendloctax[vertnum]; edgelocnum ++) {
+      if (edgegsttax[edgelocnum] < vertlocnnd)
+        fixdtax[edgegsttax[edgelocnum]] = 1;
+    }
+  }
+
+  commloadextn0 =
+  commgainextn0 = 0;
+  edlosum = 0;
+  degrmax = 0;
+  for (vertnum = edgenum = baseval; vertnum < vertlocnnd; vertnum ++) { /* Build local subgraph; ghost edges become external gains */
+    Gnum                edgelocnum;
+    Gnum                veexval;
+
+    verttax[vertnum] = edgenum;
+    veexval = (veexloctax != NULL) ? veexloctax[vertnum] : 0;
+    for (edgelocnum = vertloctax[vertnum]; edgelocnum < vendloctax[vertnum]; edgelocnum ++) {
+      Gnum                vertend;
+      Gnum                edloval;
+
+      vertend = edgegsttax[edgelocnum];
+      edloval = (edloloctax != NULL) ? edloloctax[edgelocnum] : 1;
+      if (vertend < vertlocnnd) {                 /* If local edge */
+        edgetax[edgenum] = vertend;
+        if (edlotax != NULL)
+          edlotax[edgenum] = edloval;
+        edlosum += edloval;
+        edgenum ++;
+      }
+      else {                                      /* Ghost neighbor is fixed in its part */
+        edloval *= (Gnum) grafptr->domndist;
+        if (partgsttax[vertend] == 0)             /* Cost if vertex in part 1 */
+          veexval += edloval;
+        else {                                    /* Cost if vertex in part 0 */
+          veexval       -= edloval;
+          commloadextn0 += edloval;
+        }
+      }
+    }
+    if ((edgenum - verttax[vertnum]) > degrmax)
+      degrmax = edgenum - verttax[vertnum];
+    veextax[vertnum] = veexval;
+    commgainextn0   += veexval;
+    bgrfdat.parttax[vertnum] = partgsttax[vertnum];
+  }
+  verttax[vertlocnnd] = edgenum;
+
+  cgrfdat.flagval = GRAPHNONE;
+  cgrfdat.baseval = baseval;
+  cgrfdat.vertnbr = grafptr->s.vertlocnbr;
+  cgrfdat.vertnnd = vertlocnnd;
+  cgrfdat.verttax = verttax;
+  cgrfdat.vendtax = verttax + 1;
+  cgrfdat.velotax = grafptr->s.veloloctax;
+  cgrfdat.velosum = grafptr->s.velolocsum;
+  cgrfdat.vnumtax = NULL;
+  cgrfdat.vlbltax = NULL;
+  cgrfdat.edgenbr = edgenum - baseval;
+  cgrfdat.edgetax = edgetax;
+  cgrfdat.edlotax = edlotax;
+  cgrfdat.edlosum = (edlotax != NULL) ? edlosum : cgrfdat.edgenbr;
+  cgrfdat.degrmax = degrmax;
+
+  bgrfdat.s             = cgrfdat;
+  bgrfdat.veextax       = veextax;
+  bgrfdat.compload0avg  = 0;                      /* Not used: target is given to refinement routine */
+  bgrfdat.commloadextn0 = commloadextn0;
+  bgrfdat.commgainextn0 = commgainextn0;
+  bgrfdat.domndist      = grafptr->domndist;
+  bgrfdat.domnwght[0]   = grafptr->domnwght[0];
+  bgrfdat.domnwght[1]   = grafptr->domnwght[1];
+  bgrfdat.vfixload[0]   =
+  bgrfdat.vfixload[1]   = 0;
+  bgrfdat.levlnum       = grafptr->levlnum;
+  bgrfdat.contptr       = grafptr->contptr;
+  bgraphCost (&bgrfdat);                          /* Compute local loads, cut and frontier */
+  bgrfdat.compload0min = bgrfdat.compload0 - slcktab[0]; /* Each process uses its share of the slack */
+  bgrfdat.compload0max = bgrfdat.compload0 + slcktab[1];
+  bgrfdat.compload0avg = bgrfdat.compload0 - grafptr->compglbload0dlt / grafptr->s.procglbnbr; /* Share of global imbalance to remove */
+  bgrfdat.compload0dlt = bgrfdat.compload0 - bgrfdat.compload0avg;
+  bgrfdat.bbalval      = 0.0;
+
+  fparadat.passnbr = paraptr->passnbr;
+  fparadat.bndrat  = paraptr->bndrat;
+  o = bgraphBipartFl2 (&bgrfdat, &fparadat, bgrfdat.compload0avg, fixdtax);
+
+  if (o == 0) {                                   /* Copy local parts back */
+    for (vertnum = baseval; vertnum < vertlocnnd; vertnum ++)
+      partgsttax[vertnum] = bgrfdat.parttax[vertnum];
+  }
+
+  memFree (edgetax + baseval);
+  memFree (verttax + baseval);                    /* Free group leader */
+
+  return (o);
+}
+
+/* This routine recomputes the global data of
+** the distributed bipartition from the part
+** array of the local vertices, after updating
+** the parts of the ghost vertices.
+** It returns:
+** - 0   : on success.
+** - !0  : on error.
+*/
+
+static
+int
+bdgraphBipartFlCost (
+Bdgraph * const             grafptr)
+{
+  Gnum                vertlocnum;
+  Gnum                fronlocnum;
+  Gnum                complocsize1;
+  Gnum                complocload1;
+  Gnum                commlocloadintn;
+  Gnum                commlocloadextn;
+  Gnum                commlocgainextn;
+  Gnum                reduloctab[7];
+  Gnum                reduglbtab[7];
+
+  const Gnum * restrict const veloloctax = grafptr->s.veloloctax;
+  const Gnum * restrict const edloloctax = grafptr->s.edloloctax;
+  const Gnum * restrict const edgegsttax = grafptr->s.edgegsttax;
+
+  reduloctab[6] = 0;                              /* Assume no error */
+  if (dgraphHaloSync (&grafptr->s, (byte *) (void *) (grafptr->partgsttax + grafptr->s.baseval), GRAPHPART_MPI) != 0) {
+    errorPrint ("bdgraphBipartFlCost: cannot propagate part data");
+    reduloctab[6] = 1;                            /* Error is reduced over all processes below */
+  }
+
+  commlocloadintn =
+  commlocloadextn =
+  commlocgainextn = 0;
+  for (vertlocnum = grafptr->s.baseval, fronlocnum = complocsize1 = complocload1 = 0;
+       vertlocnum < grafptr->s.vertlocnnd; vertlocnum ++) {
+    Gnum                edgelocnum;
+    Gnum                veloval;
+    Gnum                partval;
+    Gnum                flagval;
+
+    partval = (Gnum) grafptr->partgsttax[vertlocnum];
+    veloval = (veloloctax != NULL) ? veloloctax[vertlocnum] : 1;
+    if (grafptr->veexloctax != NULL) {
+      commlocloadextn += grafptr->veexloctax[vertlocnum] * partval;
+      commlocgainextn += grafptr->veexloctax[vertlocnum] * (1 - partval * 2);
+    }
+    complocsize1 += partval;
+    complocload1 += partval * veloval;
+
+    for (edgelocnum = grafptr->s.vertloctax[vertlocnum], flagval = 0;
+         edgelocnum < grafptr->s.vendloctax[vertlocnum]; edgelocnum ++) {
+      Gnum                partend;
+
+      partend  = (Gnum) grafptr->partgsttax[edgegsttax[edgelocnum]];
+      flagval |= partval ^ partend;
+      commlocloadintn += (partval ^ partend) * ((edloloctax != NULL) ? edloloctax[edgelocnum] : 1); /* Internal load is accounted for twice */
+    }
+    if (flagval != 0)                             /* If vertex has neighbors in other part */
+      grafptr->fronloctab[fronlocnum ++] = vertlocnum;
+  }
+  grafptr->complocload0 = grafptr->s.velolocsum - complocload1;
+  grafptr->complocsize0 = grafptr->s.vertlocnbr - complocsize1;
+  grafptr->fronlocnbr   = fronlocnum;
+
+  reduloctab[0] = fronlocnum;
+  reduloctab[1] = grafptr->complocload0;
+  reduloctab[2] = grafptr->complocsize0;
+  reduloctab[3] = commlocloadintn;
+  reduloctab[4] = commlocloadextn;
+  reduloctab[5] = commlocgainextn;
+  if (MPI_Allreduce (&reduloctab[0], &reduglbtab[0], 7, GNUM_MPI, MPI_SUM, grafptr->s.proccomm) != MPI_SUCCESS) {
+    errorPrint ("bdgraphBipartFlCost: communication error");
+    return (1);
+  }
+  if (reduglbtab[6] != 0)                         /* If error on some process */
+    return (1);
+  grafptr->fronglbnbr      = reduglbtab[0];
+  grafptr->compglbload0    = reduglbtab[1];
+  grafptr->compglbload0dlt = grafptr->compglbload0 - grafptr->compglbload0avg;
+  grafptr->compglbsize0    = reduglbtab[2];
+  grafptr->commglbload     = (reduglbtab[3] / 2) * grafptr->domndist + reduglbtab[4];
+  grafptr->commglbgainextn = reduglbtab[5];
+  grafptr->bbalglbval      = (double) ((grafptr->compglbload0dlt < 0) ? (- grafptr->compglbload0dlt) : grafptr->compglbload0dlt) / (double) grafptr->compglbload0avg;
+
+  return (0);
+}
+
+/* This routine restores the distributed
+** bipartition saved before the refinement:
+** parts of local and ghost vertices, local
+** frontier, and local and global loads, sizes
+** and cut. As the saved state was the same on
+** all processes, no communication is needed.
+** It returns:
+** - void  : in all cases.
+*/
+
+static
+void
+bdgraphBipartFlRestore (
+Bdgraph * const                     grafptr,      /*+ Distributed graph +*/
+const BdgraphBipartFlSave * const   saveptr)      /*+ Saved state       +*/
+{
+  memCpy (grafptr->partgsttax + grafptr->s.baseval, saveptr->partgsttax + grafptr->s.baseval, grafptr->s.vertgstnbr * sizeof (GraphPart));
+  memCpy (grafptr->fronloctab, saveptr->fronloctab, saveptr->fronlocnbr * sizeof (Gnum));
+  grafptr->fronlocnbr      = saveptr->fronlocnbr;
+  grafptr->fronglbnbr      = saveptr->fronglbnbr;
+  grafptr->complocload0    = saveptr->complocload0;
+  grafptr->compglbload0    = saveptr->compglbload0;
+  grafptr->compglbload0dlt = saveptr->compglbload0dlt;
+  grafptr->complocsize0    = saveptr->complocsize0;
+  grafptr->compglbsize0    = saveptr->compglbsize0;
+  grafptr->commglbload     = saveptr->commglbload;
+  grafptr->commglbgainextn = saveptr->commglbgainextn;
+  grafptr->bbalglbval      = saveptr->bbalglbval;
+}
+
+/*****************************/
+/*                           */
+/* This is the main routine. */
+/*                           */
+/*****************************/
+
+/* This routine performs the refinement. On
+** error, the bipartition is restored on all
+** processes.
+** It returns:
+** - 0   : if the bipartition could be computed.
+** - !0  : on error.
+*/
+
+int
+bdgraphBipartFl (
+Bdgraph * const                     grafptr,      /*+ Distributed graph +*/
+const BdgraphBipartFlParam * const  paraptr)      /*+ Method parameters +*/
+{
+  BdgraphBipartFlSave     savedat;                /* State before refinement */
+  int                     cheklocval;
+  int                     chekglbval;
+
+  if (((grafptr->s.flagval & BDGRAPHHASANCHORS) == 0) || /* Only band graphs have anchors to keep; global values: */
+      (grafptr->fronglbnbr == 0) || (paraptr->passnbr <= 0)) /* same decision on all processes                      */
+    return (0);
+
+  if (dgraphGhst (&grafptr->s) != 0) {            /* Compute ghost edge array if not already present */
+    errorPrint ("bdgraphBipartFl: cannot compute ghost edge array");
+    return (1);
+  }
+  cheklocval = 0;
+  savedat.partgsttax = NULL;
+  if (dgraphHaloSync (&grafptr->s, (byte *) (void *) (grafptr->partgsttax + grafptr->s.baseval), GRAPHPART_MPI) != 0) {
+    errorPrint ("bdgraphBipartFl: cannot propagate part data"); /* Parts of ghost vertices may not be up to date */
+    cheklocval = 1;                               /* Error is reduced over all processes below     */
+  }
+  else if (memAllocGroup ((void **) (void *)
+                          &savedat.partgsttax, (size_t) (grafptr->s.vertgstnbr * sizeof (GraphPart)),
+                          &savedat.fronloctab, (size_t) (MAX (grafptr->fronlocnbr, 1) * sizeof (Gnum)), NULL) == NULL) {
+    errorPrint ("bdgraphBipartFl: out of memory");
+    cheklocval = 1;
+  }
+  else {
+    savedat.partgsttax     -= grafptr->s.baseval;
+    memCpy (savedat.partgsttax + grafptr->s.baseval, grafptr->partgsttax + grafptr->s.baseval, grafptr->s.vertgstnbr * sizeof (GraphPart));
+    memCpy (savedat.fronloctab, grafptr->fronloctab, grafptr->fronlocnbr * sizeof (Gnum));
+    savedat.fronlocnbr      = grafptr->fronlocnbr;
+    savedat.fronglbnbr      = grafptr->fronglbnbr;
+    savedat.complocload0    = grafptr->complocload0;
+    savedat.compglbload0    = grafptr->compglbload0;
+    savedat.compglbload0dlt = grafptr->compglbload0dlt;
+    savedat.complocsize0    = grafptr->complocsize0;
+    savedat.compglbsize0    = grafptr->compglbsize0;
+    savedat.commglbload     = grafptr->commglbload;
+    savedat.commglbgainextn = grafptr->commglbgainextn;
+    savedat.bbalglbval      = grafptr->bbalglbval;
+    if (bdgraphBipartFl2 (grafptr, paraptr) != 0) /* Refine local part */
+      cheklocval = 1;
+  }
+  if (MPI_Allreduce (&cheklocval, &chekglbval, 1, MPI_INT, MPI_MAX, grafptr->s.proccomm) != MPI_SUCCESS) {
+    errorPrint ("bdgraphBipartFl: communication error");
+    chekglbval = 1;
+  }
+  if (chekglbval != 0) {                          /* If error on some process, restore bipartition and return */
+    if (savedat.partgsttax != NULL) {
+      bdgraphBipartFlRestore (grafptr, &savedat);
+      memFree (savedat.partgsttax + grafptr->s.baseval);
+    }
+    return (1);
+  }
+
+  if (bdgraphBipartFlCost (grafptr) != 0) {       /* Error is the same on all processes */
+    bdgraphBipartFlRestore (grafptr, &savedat);
+    memFree (savedat.partgsttax + grafptr->s.baseval);
+    return (1);
+  }
+  if ((grafptr->commglbload > savedat.commglbload) || /* If global cut did not improve, or balance worsened beyond bounds */
+      ((grafptr->commglbload == savedat.commglbload) && (ABS (grafptr->compglbload0dlt) >= ABS (savedat.compglbload0 - grafptr->compglbload0avg))) ||
+      ((grafptr->compglbload0 < grafptr->compglbload0min) && (grafptr->compglbload0 < savedat.compglbload0)) ||
+      ((grafptr->compglbload0 > grafptr->compglbload0max) && (grafptr->compglbload0 > savedat.compglbload0))) {
+    memCpy (grafptr->partgsttax + grafptr->s.baseval, savedat.partgsttax + grafptr->s.baseval, grafptr->s.vertlocnbr * sizeof (GraphPart)); /* Undo refinement */
+    if (bdgraphBipartFlCost (grafptr) != 0) {
+      bdgraphBipartFlRestore (grafptr, &savedat);
+      memFree (savedat.partgsttax + grafptr->s.baseval);
+      return (1);
+    }
+  }
+
+#ifdef SCOTCH_DEBUG_BDGRAPH2
+  if (bdgraphCheck (grafptr) != 0) {              /* Result of check is the same on all processes */
+    errorPrint ("bdgraphBipartFl: inconsistent graph data");
+    bdgraphBipartFlRestore (grafptr, &savedat);
+    memFree (savedat.partgsttax + grafptr->s.baseval);
+    return (1);
+  }
+#endif /* SCOTCH_DEBUG_BDGRAPH2 */
+
+  memFree (savedat.partgsttax + grafptr->s.baseval);
+
+  return (0);
+}
