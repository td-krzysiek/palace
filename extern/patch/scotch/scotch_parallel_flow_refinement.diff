+/************************************************************/
+/**                                                        **/
+/**   NAME       : bgraph_bipart_fl.c                      **/
+/**                                                        **/
+/**   AUTHOR     : Hugh CARSON                             **/
+/**                                                        **/
+/**   FUNCTION   : This module refines a bipartition by    **/
+/**                computing a minimum cut between the     **/
+/**                two parts within a region around the    **/
+/**                frontier, by means of a maximum flow.   **/
+/**                The region is chosen such that the      **/
+/**                load of each of its two halves is a     **/
+/**                multiple of the load slack of the other **/
+/**                part; a minimum cut is chosen greedily  **/
+/**                for balance; when it does not respect   **/
+/**                the load bounds, the ratio of the       **/
+/**                offending half is halved, down to 1.    **/
+/**                Only integer arithmetic is used.        **/
+/**                                                        **/
+/**   DATES      : # Version 7.0  : from : 13 nov 2026     **/
+/**                                 to   : 16 nov 2026     **/
+/**                                                        **/
+/************************************************************/
+
+/*
+**  The defines and includes.
+*/
+
+#include "module.h"
+#include "common.h"
+#include "graph.h"
+#include "arch.h"
+#include "bgraph.h"
+#include "bgraph_bipart_fl.h"
+
+/*
+**  The static definitions.
+*/
+
+#define BGRAPHBIPARTFLSRC           1             /* Node can be reached from source in residual graph */
+#define BGRAPHBIPARTFLSNK           2             /* Node can reach sink in residual graph             */
+#define BGRAPHBIPARTFLSTK           4             /* Node is in strongly connected component stack     */
+
+#define BGRAPHBIPARTFLFREE          0             /* Node belongs to no search tree                    */
+#define BGRAPHBIPARTFLTRES          1             /* Node belongs to search tree of source             */
+#define BGRAPHBIPARTFLTRET          2             /* Node belongs to search tree of sink               */
+
+#define BGRAPHBIPARTFLROOT          -1            /* Parent flag of terminal node                      */
+#define BGRAPHBIPARTFLORPH          -2            /* Parent flag of orphan node                        */
+
+#define BGRAPHBIPARTFLWORK          64            /* Work budget per vertex and arc of the graph       */
+#define BGRAPHBIPARTFLCAPAMAX       (GNUMMAX / 4) /* Bound on the sum of capacities of a flow network */
+#define BGRAPHBIPARTFLSIZEMAX       (GNUMMAX / 8) /* Bound on the size of the graph, for work counts  */
+
+/*******************************/
+/*                             */
+/* The maximum flow routine.   */
+/*                             */
+/*******************************/
+
+/* This routine computes a maximum flow from
+** the source to the sink, starting from the flow
+** already present in the residual capacities of
+** the arc array and of the terminal capacity
+** array, and leaves the new residual capacities
+** in these arrays. The terminals are not nodes
+** of the network: each node has a residual
+** capacity from the source (if positive) or to
+** the sink (if negative), and nodes with a non
+** zero terminal capacity are roots of the
+** search trees.
+** It implements the algorithm of Boykov and
+** Kolmogorov: a search tree is grown from each
+** terminal, and the trees are repaired rather
+** than rebuilt after each augmentation.
+** The work of the routine (arcs scanned, path
+** and tree walks) is charged to the given work
+** budget, which is decreased accordingly. The
+** budget is checked once per active node, so
+** that it may be exceeded by the work done for
+** one active node: it is a heuristic bound, not
+** an exact count of operations.
+** It returns:
+** - flow : the value of the flow added; if the
+**          budget is exhausted, it is negative
+**          and the flow is not maximum.
+*/
+
+static
+Gnum
+bgraphBipartFlFlow (
+const Gnum                          nodenbr,      /*+ Number of nodes                          +*/
+const Gnum * restrict const         nodeidxtab,   /*+ Arc index of each node                   +*/
+BgraphBipartFlArc * restrict const  arcstab,      /*+ Arc array                                +*/
+const Gnum * restrict const         arcrevtab,    /*+ Index of reverse arc of each arc         +*/
+Gnum * restrict const               termtab,      /*+ Residual terminal capacity of each node  +*/
+byte * restrict const               treetab,      /*+ Tree of each node                        +*/
+byte * restrict const               actvtab,      /*+ Flag set if node is in active queue      +*/
+Gnum * restrict const               parntab,      /*+ Arc from node to its parent, or flag     +*/
+Gnum * restrict const               tstmtab,      /*+ Time stamp of distance of node           +*/
+Gnum * restrict const               disttab,      /*+ Distance of node to its terminal         +*/
+Gnum * restrict const               queutab,      /*+ Circular queue of active nodes           +*/
+Gnum * restrict const               orphtab,      /*+ Stack of orphan nodes                    +*/
+Gnum * restrict const               workptr)      /*+ Remaining work budget                    +*/
+{
+  Gnum                workval;                    /* Work done                                 */
+  Gnum                flowval;
+  Gnum                queuhead;
+  Gnum                queunbr;
+  Gnum                orphnbr;
+  Gnum                tstmval;
+  Gnum                nodenum;
+
+  for (nodenum = queunbr = 0; nodenum < nodenbr; nodenum ++) { /* Nodes linked to a terminal are roots */
+    tstmtab[nodenum] = 0;
+    if (termtab[nodenum] == 0) {
+      treetab[nodenum] = BGRAPHBIPARTFLFREE;
+      actvtab[nodenum] = 0;
+      continue;
+    }
+    treetab[nodenum] = (termtab[nodenum] > 0) ? BGRAPHBIPARTFLTRES : BGRAPHBIPARTFLTRET;
+    parntab[nodenum] = BGRAPHBIPARTFLROOT;
+    disttab[nodenum] = 1;
+    tstmtab[nodenum] = 1;
+    actvtab[nodenum] = 1;
+    queutab[queunbr ++] = nodenum;
+  }
+  queuhead = 0;
+  tstmval  = 1;
+  flowval  = 0;
+  workval  = nodenbr;
+
+  while (queunbr > 0) {                           /* While there are active nodes */
+    Gnum                nodeact;
+    Gnum                arcsnum;
+    Gnum                arcsnnd;
+    Gnum                arcsmid;                  /* Arc linking the two trees, from source tree */
+    byte                treeact;
+
+    if (workval > *workptr) {                     /* If work budget exhausted, give up */
+      *workptr = 0;
+      return (-1);
+    }
+
+    nodeact = queutab[queuhead];
+    treeact = treetab[nodeact];
+    if (treeact == BGRAPHBIPARTFLFREE) {          /* If node has left its tree, drop it */
+      actvtab[nodeact] = 0;
+      queuhead = (queuhead + 1) % nodenbr;
+      queunbr --;
+      continue;
+    }
+
+    arcsmid = -1;
+    workval += nodeidxtab[nodeact + 1] - nodeidxtab[nodeact];
+    for (arcsnum = nodeidxtab[nodeact], arcsnnd = nodeidxtab[nodeact + 1]; arcsnum < arcsnnd; arcsnum ++) {
+      Gnum                nodeend;
+      Gnum                capaval;
+
+      capaval = (treeact == BGRAPHBIPARTFLTRES) ? arcstab[arcsnum].capaval : arcstab[arcrevtab[arcsnum]].capaval;
+      if (capaval <= 0)
+        continue;
+      nodeend = arcstab[arcsnum].nodeend;
+      if (treetab[nodeend] == BGRAPHBIPARTFLFREE) { /* Grow tree */
+        treetab[nodeend] = treeact;
+        parntab[nodeend] = arcrevtab[arcsnum];
+        tstmtab[nodeend] = tstmtab[nodeact];
+        disttab[nodeend] = disttab[nodeact] + 1;
+        if (actvtab[nodeend] == 0) {
+          actvtab[nodeend] = 1;
+          queutab[(queuhead + queunbr) % nodenbr] = nodeend;
+          queunbr ++;
+        }
+      }
+      else if (treetab[nodeend] != treeact) {     /* Trees meet: augmenting path found */
+        arcsmid = (treeact == BGRAPHBIPARTFLTRES) ? arcsnum : arcrevtab[arcsnum];
+        break;
+      }
+      else if ((tstmtab[nodeend] <= tstmtab[nodeact]) && /* Heuristic: get closer to terminal */
+               (disttab[nodeend] >  disttab[nodeact]) &&
+               (parntab[nodeend] >= 0)) {
+        parntab[nodeend] = arcrevtab[arcsnum];
+        tstmtab[nodeend] = tstmtab[nodeact];
+        disttab[nodeend] = disttab[nodeact] + 1;
+      }
+    }
+
+    if (arcsmid < 0) {                            /* If no path found, node is no longer active */
+      actvtab[nodeact] = 0;
+      queuhead = (queuhead + 1) % nodenbr;
+      queunbr --;
+      continue;
+    }
+
+    {                                             /* Augmentation */
+      Gnum                nodetmp;
+      Gnum                capamin;
+
+      capamin = arcstab[arcsmid].capaval;
+      for (nodetmp = arcstab[arcrevtab[arcsmid]].nodeend; parntab[nodetmp] >= 0; ) { /* Source side of path */
+        Gnum                arcstmp;
+
+        arcstmp = parntab[nodetmp];               /* Arc from node to its parent */
+        workval ++;
+        if (arcstab[arcrevtab[arcstmp]].capaval < capamin)
+          capamin = arcstab[arcrevtab[arcstmp]].capaval;
+        nodetmp = arcstab[arcstmp].nodeend;
+      }
+      if (termtab[nodetmp] < capamin)             /* Root of source tree */
+        capamin = termtab[nodetmp];
+      for (nodetmp = arcstab[arcsmid].nodeend; parntab[nodetmp] >= 0; ) { /* Sink side of path */
+        Gnum                arcstmp;
+
+        arcstmp = parntab[nodetmp];
+        workval ++;
+        if (arcstab[arcstmp].capaval < capamin)
+          capamin = arcstab[arcstmp].capaval;
+        nodetmp = arcstab[arcstmp].nodeend;
+      }
+      if ((- termtab[nodetmp]) < capamin)         /* Root of sink tree */
+        capamin = - termtab[nodetmp];
+
+      arcstab[arcsmid].capaval -= capamin;
+      arcstab[arcrevtab[arcsmid]].capaval += capamin;
+      orphnbr = 0;
+      for (nodetmp = arcstab[arcrevtab[arcsmid]].nodeend; parntab[nodetmp] >= 0; ) {
+        Gnum                arcstmp;
+        Gnum                nodeprt;
+
+        arcstmp = parntab[nodetmp];
+        nodeprt = arcstab[arcstmp].nodeend;
+        arcstab[arcrevtab[arcstmp]].capaval -= capamin;
+        arcstab[arcstmp].capaval += capamin;
+        if (arcstab[arcrevtab[arcstmp]].capaval == 0) { /* If tree arc saturated, node becomes orphan */
+          parntab[nodetmp]   = BGRAPHBIPARTFLORPH;
+          orphtab[orphnbr ++] = nodetmp;
+        }
+        nodetmp = nodeprt;
+      }
+      termtab[nodetmp] -= capamin;
+      if (termtab[nodetmp] == 0) {                /* If source capacity of root exhausted */
+        parntab[nodetmp]   = BGRAPHBIPARTFLORPH;
+        orphtab[orphnbr ++] = nodetmp;
+      }
+      for (nodetmp = arcstab[arcsmid].nodeend; parntab[nodetmp] >= 0; ) {
+        Gnum                arcstmp;
+        Gnum                nodeprt;
+
+        arcstmp = parntab[nodetmp];
+        nodeprt = arcstab[arcstmp].nodeend;
+        arcstab[arcstmp].capaval -= capamin;
+        arcstab[arcrevtab[arcstmp]].capaval += capamin;
+        if (arcstab[arcstmp].capaval == 0) {
+          parntab[nodetmp]   = BGRAPHBIPARTFLORPH;
+          orphtab[orphnbr ++] = nodetmp;
+        }
+        nodetmp = nodeprt;
+      }
+      termtab[nodetmp] += capamin;
+      if (termtab[nodetmp] == 0) {                /* If sink capacity of root exhausted */
+        parntab[nodetmp]   = BGRAPHBIPARTFLORPH;
+        orphtab[orphnbr ++] = nodetmp;
+      }
+      flowval += capamin;
+    }
+
+    tstmval ++;
+    while (orphnbr > 0) {                         /* Adoption of orphans */
+      Gnum                nodeorp;
+      Gnum                arcsbst;
+      Gnum                distbst;
+      byte                treeorp;
+
+      nodeorp = orphtab[-- orphnbr];
+      treeorp = treetab[nodeorp];
+      workval += 2 * (nodeidxtab[nodeorp + 1] - nodeidxtab[nodeorp]);
+      arcsbst = -1;
+      distbst = GNUMMAX;
+      for (arcsnum = nodeidxtab[nodeorp], arcsnnd = nodeidxtab[nodeorp + 1]; arcsnum < arcsnnd; arcsnum ++) {
+        Gnum                nodeend;
+        Gnum                nodetmp;
+        Gnum                capaval;
+        Gnum                distval;
+
+        nodeend = arcstab[arcsnum].nodeend;
+        if (treetab[nodeend] != treeorp)
+          continue;
+        capaval = (treeorp == BGRAPHBIPARTFLTRES) ? arcstab[arcrevtab[arcsnum]].capaval : arcstab[arcsnum].capaval;
+        if (capaval <= 0)
+          continue;
+        for (nodetmp = nodeend, distval = 0; ; ) { /* Check that candidate parent is rooted at terminal */
+          if (tstmtab[nodetmp] == tstmval) {
+            distval += disttab[nodetmp];
+            break;
+          }
+          if (parntab[nodetmp] < 0) {
+            if (parntab[nodetmp] != BGRAPHBIPARTFLROOT)
+              distval = GNUMMAX;                  /* Orphan origin */
+            else {
+              tstmtab[nodetmp] = tstmval;
+              disttab[nodetmp] = 1;
+              distval ++;
+            }
+            break;
+          }
+          distval ++;
+          workval ++;
+          nodetmp = arcstab[parntab[nodetmp]].nodeend;
+        }
+        if (distval == GNUMMAX)
+          continue;
+        if (distval < distbst) {
+          arcsbst = arcsnum;
+          distbst = distval;
+        }
+        for (nodetmp = nodeend; tstmtab[nodetmp] != tstmval; distval --) { /* Mark path for later checks */
+          tstmtab[nodetmp] = tstmval;
+          disttab[nodetmp] = distval;
+          nodetmp = arcstab[parntab[nodetmp]].nodeend;
+        }
+      }
+
+      if (arcsbst >= 0) {                         /* If new parent found */
+        parntab[nodeorp] = arcsbst;
+        tstmtab[nodeorp] = tstmval;
+        disttab[nodeorp] = distbst + 1;
+        continue;
+      }
+
+      for (arcsnum = nodeidxtab[nodeorp], arcsnnd = nodeidxtab[nodeorp + 1]; arcsnum < arcsnnd; arcsnum ++) { /* Free orphan */
+        Gnum                nodeend;
+        Gnum                capaval;
+
+        nodeend = arcstab[arcsnum].nodeend;
+        if (treetab[nodeend] != treeorp)
+          continue;
+        capaval = (treeorp == BGRAPHBIPARTFLTRES) ? arcstab[arcrevtab[arcsnum]].capaval : arcstab[arcsnum].capaval;
+        if ((capaval > 0) && (actvtab[nodeend] == 0)) { /* Neighbor may grow tree into freed node */
+          actvtab[nodeend] = 1;
+          queutab[(queuhead + queunbr) % nodenbr] = nodeend;
+          queunbr ++;
+        }
+        if ((parntab[nodeend] >= 0) &&            /* If neighbor was a child of orphan, it becomes orphan */
+            (arcstab[parntab[nodeend]].nodeend == nodeorp)) {
+          parntab[nodeend]   = BGRAPHBIPARTFLORPH;
+          orphtab[orphnbr ++] = nodeend;
+        }
+      }
+      treetab[nodeorp] = BGRAPHBIPARTFLFREE;
+    }
+  }
+
+  *workptr -= workval;
+  return (flowval);
+}
+
+/*****************************/
+/*                           */
+/* This is the main routine. */
+/*                           */
+/*****************************/
+
+/* This routine performs the bipartitioning.
+** A region is grown around the frontier, the
+** load of each of its halves being bounded by
+** a multiple of the load slack of the other
+** part. A maximum flow is computed between the
+** rest of the two parts, and a minimum cut is
+** chosen greedily for balance: starting from
+** the minimum cut closest to the source, the
+** strongly connected components of the residual
+** graph are added to the source side one at a
+** time, in reverse topological order, whenever
+** this brings the load of part 0 closer to the
+** given target load. This heuristic may miss the
+** minimum cut of best balance, and a minimum cut
+** within the load bounds when one exists. If the
+** chosen cut does not respect the load bounds,
+** the multiple of the offending half is halved,
+** and the vertices of this half that are no
+** longer in the region are merged with their
+** terminal: the current flow remains valid, and
+** is only augmented. Flagged vertices never
+** enter the region. When the capacities of the
+** flow networks could exceed a quarter of the
+** largest integer, or the size of the graph an
+** eighth of it, the bipartition is kept. The
+** work is charged to a budget proportional to
+** the size of the graph; when it is exhausted,
+** the current bipartition is kept.
+** It returns:
+** - 0 : if bipartitioning could be computed.
+** - 1 : on error.
+*/
+
+int
+bgraphBipartFl2 (
+Bgraph * restrict const           grafptr,        /*+ Active graph                          +*/
+const BgraphBipartFlParam * const paraptr,        /*+ Method parameters                     +*/
+const Gnum                        compload0avg,   /*+ Load of part 0 to tend towards        +*/
+const byte * restrict const       fixdtax)        /*+ Flags of vertices not to move, or NULL +*/
+{
+  Gnum * restrict     indxtax;                    /* Index of region node of graph vertex, or ~0     */
+  Gnum * restrict     regntab;                    /* Graph vertex of each region node, and BFS queue */
+  Gnum * restrict     cumltab;                    /* Load of region half up to each region node      */
+  Gnum * restrict     stmptax;                    /* Number of last region containing vertex         */
+  Gnum                stmpval;                    /* Number of current region                        */
+  Gnum                bndrat[2];                  /* Current ratios of region loads to load slacks   */
+  Gnum                passnum;
+  Gnum                capasum;                    /* Sum of all capacities of any network            */
+  Gnum                workval;                    /* Remaining work budget                           */
+  int                 chngval;                    /* Flag set if partition changed                   */
+  int                 o;
+
+  const Gnum * restrict const verttax = grafptr->s.verttax; /* Fast accesses */
+  const Gnum * restrict const vendtax = grafptr->s.vendtax;
+  const Gnum * restrict const velotax = grafptr->s.velotax;
+  const Gnum * restrict const edgetax = grafptr->s.edgetax;
+  const Gnum * restrict const edlotax = grafptr->s.edlotax;
+  const Gnum * restrict const veextax = grafptr->veextax;
+  GraphPart * restrict const  parttax = grafptr->parttax;
+
+  if ((grafptr->fronnbr == 0) || (paraptr->passnbr <= 0))
+    return (0);
+
+  capasum = 0;                                    /* Capacities and their sums must be representable: */
+  if (veextax != NULL) {                          /* residual capacities and terminal capacities can  */
+    Gnum                vertnum;                  /* reach twice the sum of all capacities, plus one  */
+
+    for (vertnum = grafptr->s.baseval; vertnum < grafptr->s.vertnnd; vertnum ++) {
+      Gnum                veexval;
+
+      veexval = veextax[vertnum];
+      if ((veexval > BGRAPHBIPARTFLCAPAMAX) || (veexval < - BGRAPHBIPARTFLCAPAMAX))
+        return (0);
+      capasum += ABS (veexval);
+      if (capasum > BGRAPHBIPARTFLCAPAMAX)        /* If network could overflow, keep bipartition */
+        return (0);
+    }
+  }
+  if (edlotax != NULL) {
+    Gnum                vertnum;
+
+    for (vertnum = grafptr->s.baseval; vertnum < grafptr->s.vertnnd; vertnum ++) {
+      Gnum                edgenum;
+
+      for (edgenum = verttax[vertnum]; edgenum < vendtax[vertnum]; edgenum ++) {
+        if (edlotax[edgenum] > ((BGRAPHBIPARTFLCAPAMAX - capasum) / (Gnum) grafptr->domndist))
+          return (0);
+        capasum += edlotax[edgenum] * (Gnum) grafptr->domndist;
+      }
+    }
+  }
+  else if (grafptr->s.edgenbr > ((BGRAPHBIPARTFLCAPAMAX - capasum) / (Gnum) grafptr->domndist))
+    return (0);
+  if (grafptr->s.vertnbr > (BGRAPHBIPARTFLSIZEMAX - grafptr->s.edgenbr)) /* If work counts could overflow, keep bipartition */
+    return (0);
+
+  if (memAllocGroup ((void **) (void *)
+                     &indxtax, (size_t) (grafptr->s.vertnbr * sizeof (Gnum)),
+                     &regntab, (size_t) (grafptr->s.vertnbr * sizeof (Gnum)),
+                     &cumltab, (size_t) (grafptr->s.vertnbr * sizeof (Gnum)),
+                     &stmptax, (size_t) (grafptr->s.vertnbr * sizeof (Gnum)), NULL) == NULL) {
+    errorPrint ("bgraphBipartFl2: out of memory (1)");
+    return (1);
+  }
+  memSet (indxtax, ~0, grafptr->s.vertnbr * sizeof (Gnum));
+  memSet (stmptax,  0, grafptr->s.vertnbr * sizeof (Gnum));
+  indxtax -= grafptr->s.baseval;
+  stmptax -= grafptr->s.baseval;
+  stmpval  = 0;
+
+  bndrat[0] =
+  bndrat[1] = (paraptr->bndrat < 1.0) ? 1 : ((paraptr->bndrat >= (double) GNUMMAX) ? GNUMMAX : (Gnum) paraptr->bndrat); /* At least 1, no overflow */
+  workval = grafptr->s.vertnbr + grafptr->s.edgenbr; /* Work budget; graph size and charges cannot overflow */
+  workval = (workval > (GNUMMAX / (2 * BGRAPHBIPARTFLWORK))) ? (GNUMMAX / 2) : (BGRAPHBIPARTFLWORK * workval);
+  chngval = 0;
+  o       = 0;
+  for (passnum = 0; passnum < paraptr->passnbr; ) { /* One region per iteration */
+    BgraphBipartFlArc * restrict  arcstab;
+    Gnum * restrict     arcrevtab;                /* Index of reverse arc of each arc             */
+    Gnum * restrict     nodeidxtab;               /* Arc index of each node                       */
+    Gnum * restrict     termtab;                  /* Residual terminal capacity of region nodes   */
+    Gnum * restrict     levltab;
+    Gnum * restrict     itertab;
+    Gnum * restrict     queutab;
+    Gnum * restrict     lowltab;
+    Gnum * restrict     scctab;                   /* Component of node                            */
+    Gnum * restrict     sccverttab;               /* Nodes of components, in order of creation    */
+    Gnum * restrict     sccidxtab;                /* Start index of components in sccverttab      */
+    byte * restrict     flagtab;
+    byte * restrict     treetab;                  /* Search tree of each node during flow         */
+    Gnum                slcktab[2];               /* Load slacks of both parts                    */
+    Gnum                bndtab[2];                /* Load limits of region halves                 */
+    Gnum                regload[2];               /* Load of region halves                        */
+    Gnum                regnbr;                   /* Number of region nodes                       */
+    Gnum                regnum;
+    Gnum                nodenbr;
+    Gnum                arcsnbr;
+    Gnum                cutsval;                  /* Capacity of current cut in flow network      */
+    Gnum                flowval;
+    Gnum                fronnum;
+    Gnum                queunum;
+    int                 doneval;                  /* Flag set when region is finished             */
+
+    if (workval <= 0)                             /* If work budget exhausted, stop */
+      break;
+
+    slcktab[0] = MAX (grafptr->compload0 - grafptr->compload0min, 0); /* Part 0 can lose that much */
+    slcktab[1] = MAX (grafptr->compload0max - grafptr->compload0, 0); /* Part 0 can gain that much */
+    bndtab[0]  = (slcktab[0] > (GNUMMAX / bndrat[0])) ? GNUMMAX : (bndrat[0] * slcktab[0]); /* Avoid overflow */
+    bndtab[1]  = (slcktab[1] > (GNUMMAX / bndrat[1])) ? GNUMMAX : (bndrat[1] * slcktab[1]);
+    if ((bndtab[0] | bndtab[1]) == 0)             /* If no slack at all, nothing to do */
+      break;
+
+    regload[0] =
+    regload[1] = 0;
+    for (fronnum = regnbr = 0; fronnum < grafptr->fronnbr; fronnum ++) { /* First layer is frontier */
+      Gnum                vertnum;
+      Gnum                veloval;
+      GraphPart           partval;
+
+      vertnum = grafptr->frontab[fronnum];
+      partval = parttax[vertnum];
+      veloval = (velotax != NULL) ? velotax[vertnum] : 1;
+      if (((regload[partval] + veloval) > bndtab[partval]) ||
+          ((fixdtax != NULL) && (fixdtax[vertnum] != 0)))
+        continue;
+      regload[partval] += veloval;
+      indxtax[vertnum]  = regnbr;
+      cumltab[regnbr]   = regload[partval];
+      regntab[regnbr ++] = vertnum;
+    }
+    for (queunum = 0; queunum < regnbr; queunum ++) { /* Breadth-first growth of region */
+      Gnum                vertnum;
+      Gnum                edgenum;
+
+      vertnum = regntab[queunum];
+      for (edgenum = verttax[vertnum]; edgenum < vendtax[vertnum]; edgenum ++) {
+        Gnum                vertend;
+        Gnum                veloend;
+        GraphPart           partend;
+
+        vertend = edgetax[edgenum];
+        if (indxtax[vertend] != ~0)
+          continue;
+        partend = parttax[vertend];
+        veloend = (velotax != NULL) ? velotax[vertend] : 1;
+        if (((regload[partend] + veloend) > bndtab[partend]) ||
+            ((fixdtax != NULL) && (fixdtax[vertend] != 0)))
+          continue;
+        regload[partend] += veloend;
+        indxtax[vertend]  = regnbr;
+        cumltab[regnbr]   = regload[partend];
+        regntab[regnbr ++] = vertend;
+      }
+    }
+
+    if (regnbr == 0)                              /* If no vertex fits in region, nothing to do */
+      break;
+
+    for (regnum = 0; regnum < regnbr; regnum ++) { /* See if region is within previous region */
+      if (stmptax[regntab[regnum]] != stmpval)
+        break;
+    }
+    if ((stmpval > 0) && (regnum == regnbr)) {    /* If so, merging vertices with terminals cannot lower the minimum cut */
+      for (regnum = 0; regnum < regnbr; regnum ++)
+        indxtax[regntab[regnum]] = ~0;
+      break;
+    }
+    stmpval ++;
+    for (regnum = 0; regnum < regnbr; regnum ++)
+      stmptax[regntab[regnum]] = stmpval;
+
+    nodenbr = regnbr;
+    if (memAllocGroup ((void **) (void *)
+                       &nodeidxtab, (size_t) ((nodenbr + 1) * sizeof (Gnum)),
+                       &termtab,    (size_t) (nodenbr       * sizeof (Gnum)),
+                       &levltab,    (size_t) (nodenbr       * sizeof (Gnum)),
+                       &itertab,    (size_t) (nodenbr       * sizeof (Gnum)),
+                       &queutab,    (size_t) (nodenbr       * sizeof (Gnum)),
+                       &lowltab,    (size_t) (nodenbr       * sizeof (Gnum)),
+                       &scctab,     (size_t) (nodenbr       * sizeof (Gnum)),
+                       &sccverttab, (size_t) (nodenbr       * sizeof (Gnum)),
+                       &sccidxtab,  (size_t) ((nodenbr + 1) * sizeof (Gnum)),
+                       &flagtab,    (size_t) (nodenbr       * sizeof (byte)),
+                       &treetab,    (size_t) (nodenbr       * sizeof (byte)), NULL) == NULL) {
+      errorPrint ("bgraphBipartFl2: out of memory (2)");
+      o = 1;
+      break;
+    }
+
+    cutsval = 0;                                  /* Count arcs of each node */
+    flowval = 0;
+    for (regnum = 0; regnum < regnbr; regnum ++) {
+      Gnum                vertnum;
+      Gnum                edgenum;
+      Gnum                degrval;
+      Gnum                capatmp[2];             /* Capacities to source and to sink */
+      GraphPart           partval;
+
+      vertnum = regntab[regnum];
+      partval = parttax[vertnum];
+      capatmp[0] =
+      capatmp[1] = 0;
+      for (edgenum = verttax[vertnum], degrval = 0; edgenum < vendtax[vertnum]; edgenum ++) {
+        Gnum                vertend;
+        Gnum                edloval;
+
+        vertend = edgetax[edgenum];
+        edloval = ((edlotax != NULL) ? edlotax[edgenum] : 1) * (Gnum) grafptr->domndist;
+        if (indxtax[vertend] != ~0) {
+          degrval ++;
+          if ((partval == 0) && (parttax[vertend] != 0))
+            cutsval += edloval;
+        }
+        else
+          capatmp[parttax[vertend]] += edloval;
+      }
+      if (veextax != NULL) {                      /* External gain if moved to part 1 is a cost if in sink side */
+        Gnum                veexval;
+
+        veexval = veextax[vertnum];
+        if (veexval > 0)
+          capatmp[0] += veexval;
+        else
+          capatmp[1] -= veexval;
+      }
+      cutsval += capatmp[partval ^ 1];            /* Terminal arc of other part is cut */
+      flowval += MIN (capatmp[0], capatmp[1]);    /* Flow directly from source to sink through node */
+      termtab[regnum]    = capatmp[0] - capatmp[1];
+      nodeidxtab[regnum] = degrval;
+    }
+    for (regnum = arcsnbr = 0; regnum < nodenbr; regnum ++) { /* Turn degrees into indices */
+      Gnum                degrval;
+
+      degrval = nodeidxtab[regnum];
+      nodeidxtab[regnum] =
+      itertab[regnum]    = arcsnbr;
+      arcsnbr += degrval;
+    }
+    nodeidxtab[nodenbr] = arcsnbr;
+    workval -= 2 * (nodenbr + arcsnbr);           /* Account for building region and network */
+
+    if (((arcstab   = memAlloc (MAX (arcsnbr, 1) * sizeof (BgraphBipartFlArc))) == NULL) ||
+        ((arcrevtab = memAlloc (MAX (arcsnbr, 1) * sizeof (Gnum)))              == NULL)) {
+      errorPrint ("bgraphBipartFl2: out of memory (3)");
+      if (arcstab != NULL)
+        memFree (arcstab);
+      memFree (nodeidxtab);
+      o = 1;
+      break;
+    }
+
+    for (regnum = 0; regnum < regnbr; regnum ++) { /* Fill arc array */
+      Gnum                vertnum;
+      Gnum                edgenum;
+
+      vertnum = regntab[regnum];
+      for (edgenum = verttax[vertnum]; edgenum < vendtax[vertnum]; edgenum ++) {
+        Gnum                regnend;
+
+        regnend = indxtax[edgetax[edgenum]];
+        if (regnend > regnum) {                   /* Create both arcs of edge once */
+          Gnum                arcsnum;
+          Gnum                arcsend;
+          Gnum                edloval;
+
+          edloval = ((edlotax != NULL) ? edlotax[edgenum] : 1) * (Gnum) grafptr->domndist;
+          arcsnum = itertab[regnum] ++;
+          arcsend = itertab[regnend] ++;
+          arcstab[arcsnum].nodeend = regnend;
+          arcstab[arcsnum].capaval = edloval;
+          arcrevtab[arcsnum]       = arcsend;
+          arcstab[arcsend].nodeend = regnum;
+          arcstab[arcsend].capaval = edloval;
+          arcrevtab[arcsend]       = arcsnum;
+        }
+      }
+    }
+
+    for (doneval = 0; doneval == 0; ) {           /* For all flow computations on this region */
+      Gnum                compload0;              /* Load of part 0 for the selected minimum cut */
+      Gnum                sccnbr;
+      Gnum                sccvertnbr;
+      Gnum                dltaold;
+      Gnum                dltanew;
+      Gnum                flowtmp;
+      int                 partval;
+
+      workval -= 3 * (nodenbr + arcsnbr);         /* Account for cut selection after flow */
+      flowtmp  = bgraphBipartFlFlow (nodenbr, nodeidxtab, arcstab, arcrevtab, termtab,
+                                     treetab, flagtab, levltab, itertab, lowltab, queutab, scctab, &workval);
+      if (flowtmp < 0) {                          /* If work budget exhausted, keep current partition */
+        passnum = paraptr->passnbr;
+        break;
+      }
+      flowval += flowtmp;
+      passnum ++;
+#ifdef SCOTCH_DEBUG_BGRAPH2
+      if (flowval > cutsval) {
+        errorPrint ("bgraphBipartFl2: internal error (1)");
+        o = 1;
+        break;
+      }
+#endif /* SCOTCH_DEBUG_BGRAPH2 */
+
+      memSet (flagtab, 0, nodenbr * sizeof (byte));
+      for (regnum = queunum = 0; queunum < nodenbr; queunum ++) { /* Nodes reachable from source in residual graph */
+        if (termtab[queunum] > 0) {
+          flagtab[queunum]   = BGRAPHBIPARTFLSRC;
+          queutab[regnum ++] = queunum;
+        }
+      }
+      for (queunum = 0; queunum < regnum; queunum ++) {
+        Gnum                nodenum;
+        Gnum                arcsnum;
+
+        nodenum = queutab[queunum];
+        for (arcsnum = nodeidxtab[nodenum]; arcsnum < nodeidxtab[nodenum + 1]; arcsnum ++) {
+          Gnum                nodeend;
+
+          nodeend = arcstab[arcsnum].nodeend;
+          if ((arcstab[arcsnum].capaval > 0) && (flagtab[nodeend] == 0)) {
+            flagtab[nodeend]   = BGRAPHBIPARTFLSRC;
+            queutab[regnum ++] = nodeend;
+          }
+        }
+      }
+      for (regnum = queunum = 0; queunum < nodenbr; queunum ++) { /* Nodes that can reach sink in residual graph */
+        if (termtab[queunum] < 0) {
+          flagtab[queunum]  |= BGRAPHBIPARTFLSNK;
+          queutab[regnum ++] = queunum;
+        }
+      }
+      for (queunum = 0; queunum < regnum; queunum ++) {
+        Gnum                nodenum;
+        Gnum                arcsnum;
+
+        nodenum = queutab[queunum];
+        for (arcsnum = nodeidxtab[nodenum]; arcsnum < nodeidxtab[nodenum + 1]; arcsnum ++) {
+          Gnum                nodeend;
+
+          nodeend = arcstab[arcsnum].nodeend;
+          if ((arcstab[arcrevtab[arcsnum]].capaval > 0) && ((flagtab[nodeend] & BGRAPHBIPARTFLSNK) == 0)) {
+            flagtab[nodeend]  |= BGRAPHBIPARTFLSNK;
+            queutab[regnum ++] = nodeend;
+          }
+        }
+      }
+
+      compload0 = grafptr->compload0 - regload[0]; /* Load of part 0 for minimal source side */
+      for (regnum = 0; regnum < regnbr; regnum ++) {
+        if (flagtab[regnum] == BGRAPHBIPARTFLSRC)
+          compload0 += (velotax != NULL) ? velotax[regntab[regnum]] : 1;
+      }
+
+      for (regnum = 0; regnum < regnbr; regnum ++) /* Strongly connected components of undecided nodes */
+        levltab[regnum] = -1;
+      sccnbr     =
+      sccvertnbr = 0;
+      {
+        Gnum                dfsnnum;              /* Depth-first search index                     */
+        Gnum                stcknbr;              /* Size of component stack (in lowltab's spare) */
+        Gnum                callnbr;              /* Size of call stack                           */
+        Gnum                rootnum;
+
+        dfsnnum = 0;
+        stcknbr = 0;
+        for (rootnum = 0; rootnum < regnbr; rootnum ++) {
+          if ((flagtab[rootnum] != 0) || (levltab[rootnum] >= 0))
+            continue;
+
+          levltab[rootnum] =
+          lowltab[rootnum] = dfsnnum ++;
+          itertab[rootnum] = nodeidxtab[rootnum];
+          sccverttab[stcknbr ++] = rootnum;       /* Component stack grows from start of sccverttab */
+          flagtab[rootnum] = BGRAPHBIPARTFLSTK;
+          queutab[0] = rootnum;                   /* Call stack */
+          callnbr = 1;
+          while (callnbr > 0) {
+            Gnum                nodenum;
+
+            nodenum = queutab[callnbr - 1];
+            if (itertab[nodenum] < nodeidxtab[nodenum + 1]) {
+              Gnum                arcsnum;
+              Gnum                nodeend;
+
+              arcsnum = itertab[nodenum] ++;
+              nodeend = arcstab[arcsnum].nodeend;
+              if ((arcstab[arcsnum].capaval <= 0) ||
+                  ((flagtab[nodeend] & (BGRAPHBIPARTFLSRC | BGRAPHBIPARTFLSNK)) != 0))
+                continue;
+              if (levltab[nodeend] < 0) {         /* If node not yet visited, recurse */
+                levltab[nodeend] =
+                lowltab[nodeend] = dfsnnum ++;
+                itertab[nodeend] = nodeidxtab[nodeend];
+                sccverttab[stcknbr ++] = nodeend;
+                flagtab[nodeend] = BGRAPHBIPARTFLSTK;
+                queutab[callnbr ++] = nodeend;
+              }
+              else if ((flagtab[nodeend] & BGRAPHBIPARTFLSTK) != 0) {
+                if (levltab[nodeend] < lowltab[nodenum])
+                  lowltab[nodenum] = levltab[nodeend];
+              }
+            }
+            else {                                /* All arcs of node processed */
+              if (lowltab[nodenum] == levltab[nodenum]) { /* If node is root of a component */
+                Gnum                nodetmp;
+
+                sccidxtab[sccnbr] = sccvertnbr;
+                do {                              /* Components are stored in creation order at end of array */
+                  nodetmp = sccverttab[-- stcknbr];
+                  flagtab[nodetmp] = 0;
+                  scctab[nodetmp]  = sccnbr;
+                  queutab[nodenbr - 1 - (sccvertnbr ++)] = nodetmp; /* Temporary storage at end of queue */
+                } while (nodetmp != nodenum);
+                sccnbr ++;
+              }
+              callnbr --;
+              if (callnbr > 0) {
+                Gnum                nodeprv;
+
+                nodeprv = queutab[callnbr - 1];
+                if (lowltab[nodenum] < lowltab[nodeprv])
+                  lowltab[nodeprv] = lowltab[nodenum];
+              }
+            }
+          }
+        }
+        sccidxtab[sccnbr] = sccvertnbr;
+        for (regnum = 0; regnum < sccvertnbr; regnum ++) /* Move component nodes to their array */
+          sccverttab[regnum] = queutab[nodenbr - 1 - regnum];
+      }
+
+      {
+        Gnum                sccnum;
+        for (sccnum = 0; sccnum < sccnbr; sccnum ++) { /* Components are in reverse topological order */
+          Gnum                sccload;
+          Gnum                sccidx;
+          int                 blokval;
+
+          for (sccidx = sccidxtab[sccnum], sccload = 0, blokval = 0;
+               sccidx < sccidxtab[sccnum + 1]; sccidx ++) {
+            Gnum                nodenum;
+            Gnum                arcsnum;
+
+            nodenum  = sccverttab[sccidx];
+            sccload += (velotax != NULL) ? velotax[regntab[nodenum]] : 1;
+            for (arcsnum = nodeidxtab[nodenum]; arcsnum < nodeidxtab[nodenum + 1]; arcsnum ++) {
+              Gnum                nodeend;
+
+              nodeend = arcstab[arcsnum].nodeend;
+              if ((arcstab[arcsnum].capaval > 0) &&
+                  ((flagtab[nodeend] & BGRAPHBIPARTFLSRC) == 0) && (scctab[nodeend] != sccnum))
+                blokval = 1;                      /* Successor component not in source side */
+            }
+          }
+          if ((blokval == 0) &&
+              (ABS (compload0 + sccload - compload0avg) < ABS (compload0 - compload0avg))) {
+            compload0 += sccload;
+            for (sccidx = sccidxtab[sccnum]; sccidx < sccidxtab[sccnum + 1]; sccidx ++)
+              flagtab[sccverttab[sccidx]] = BGRAPHBIPARTFLSRC; /* Add component to source side */
+          }
+        }
+      }
+
+      dltaold = ABS (grafptr->compload0 - compload0avg);
+      dltanew = ABS (compload0 - compload0avg);
+      if ((compload0 >= grafptr->compload0min) && /* If minimum cut respects load bounds */
+          (compload0 <= grafptr->compload0max)) {
+        if ((flowval < cutsval) || (dltanew < dltaold)) { /* If it improves, apply it and build new region */
+          for (regnum = 0; regnum < regnbr; regnum ++)
+            parttax[regntab[regnum]] = ((flagtab[regnum] & BGRAPHBIPARTFLSRC) != 0) ? 0 : 1;
+          bgraphCost (grafptr);                   /* Update loads, cut and frontier */
+          chngval = 1;
+        }
+        else                                      /* Nothing more to gain */
+          passnum = paraptr->passnbr;
+        doneval = 1;
+      }
+      else {                                      /* Cut not acceptable: shrink offending half of region */
+        Gnum                capaval;
+
+        partval = (compload0 < grafptr->compload0min) ? 0 : 1; /* Part 0 lost too much, or part 1 lost too much */
+        if ((bndrat[partval] <= 1) || (passnum >= paraptr->passnbr)) { /* Should not happen for ratio 1 */
+          passnum = paraptr->passnbr;
+          doneval = 1;
+          continue;
+        }
+        bndrat[partval] /= 2;
+        bndtab[partval]  = (slcktab[partval] > (GNUMMAX / bndrat[partval])) ? GNUMMAX : (bndrat[partval] * slcktab[partval]);
+        capaval = cutsval + 1;                    /* Larger than any flow in network */
+        for (regnum = 0; regnum < regnbr; regnum ++) { /* Merge nodes beyond new limit with their terminal */
+          if ((parttax[regntab[regnum]] == partval) &&
+              (cumltab[regnum] >  bndtab[partval]) &&
+              (cumltab[regnum] != GNUMMAX)) {     /* If not already merged */
+            if (partval == 0) {                   /* Infinite capacity from source            */
+              if (termtab[regnum] < 0)            /* Residual capacity to sink is used at once */
+                flowval -= termtab[regnum];
+              termtab[regnum] += capaval;
+            }
+            else {                                /* Infinite capacity to sink */
+              if (termtab[regnum] > 0)
+                flowval += termtab[regnum];
+              termtab[regnum] -= capaval;
+            }
+            cumltab[regnum] = GNUMMAX;            /* Never merge it again */
+          }
+        }
+      }
+    }
+
+    for (regnum = 0; regnum < regnbr; regnum ++)  /* Reset index array */
+      indxtax[regntab[regnum]] = ~0;
+
+    memFree (arcrevtab);
+    memFree (arcstab);
+    memFree (nodeidxtab);                         /* Free group leader */
+    if (o != 0)
+      break;
+  }
+
+  memFree (indxtax + grafptr->s.baseval);         /* Free group leader */
+
+  if (chngval != 0)
+    grafptr->bbalval = (double) ((grafptr->compload0dlt < 0) ? (- grafptr->compload0dlt) : grafptr->compload0dlt) / (double) grafptr->compload0avg;
+
+  return (o);
+}
+
+/* This routine performs the bipartitioning,
+** tending towards the average load of part 0.
+** It returns:
+** - 0 : if bipartitioning could be computed.
+** - 1 : on error.
+*/
+
+int
+bgraphBipartFl (
+Bgraph * restrict const           grafptr,        /*+ Active graph      +*/
+const BgraphBipartFlParam * const paraptr)        /*+ Method parameters +*/
+{
+  if (bgraphBipartFl2 (grafptr, paraptr, grafptr->compload0avg, NULL) != 0)
+    return (1);
+
+#ifdef SCOTCH_DEBUG_BGRAPH2
+  if (bgraphCheck (grafptr) != 0) {
+    errorPrint ("bgraphBipartFl: inconsistent graph data");
+    return (1);
+  }
+#endif /* SCOTCH_DEBUG_BGRAPH2 */
+
+  return (0);
+}
